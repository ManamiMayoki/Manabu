							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.data.length).to.eql(6);",
							"});",
							"pm.test(\"Header contains Content-Type json\", function () {",
							"    pm.response.to.have.header(\"content-type\");",
							"});"
