		{
			"name": "Create New Registration",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201 Created\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has success true and required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.success).to.eql(true);",
							"    ",
							"    // Set variables at collection level",
							"    pm.collectionVariables.set(\"registration_id\", jsonData.data._id);",
							"    pm.collectionVariables.set(\"ticket_code\", jsonData.data.ticketCode);",
							"    pm.collectionVariables.set(\"registered_email\", jsonData.data.email);",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
